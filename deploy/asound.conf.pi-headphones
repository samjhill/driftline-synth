# Force 3.5 mm headphone jack (card 0) as ALSA default on Raspberry Pi.
# Installed to /etc/asound.conf by scripts/setup_pi_audio.sh
#
# "default" alone often fails on headless Bookworm (speaker-test error -524).

pcm.!default {
    type plug
    slave.pcm "hw:0,0"
    hint {
        show on
        description "Pi headphone jack (bcm2835)"
    }
}

ctl.!default {
    type hw
    card 0
}
