#cloud-config
# Minimal cloud-init — WiFi (network-config), user (Imager), SSH, install firstboot systemd unit only.
# All provisioning runs in pi-ambient-firstboot.service (not runcmd).

package_update: false
package_upgrade: false
timezone: America/New_York

runcmd:
  - touch /boot/firmware/ssh /boot/ssh 2>/dev/null || true
  - systemctl enable ssh 2>/dev/null || systemctl enable sshd 2>/dev/null || true
  - systemctl start ssh 2>/dev/null || systemctl start sshd 2>/dev/null || true
  - |
    set +e
    for d in /boot/firmware/pi-ambient-synth /boot/pi-ambient-synth; do
      if test -x "$d/scripts/install_firstboot_unit.sh"; then
        bash "$d/scripts/install_firstboot_unit.sh"
        exit 0
      fi
    done
    echo "$(date -Iseconds) [fail] CLOUD_INIT no install_firstboot_unit.sh" \
      >> /boot/firmware/pi-ambient-firstboot-status.txt 2>/dev/null || true
