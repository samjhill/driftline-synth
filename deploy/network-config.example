#cloud-config
# Copy to deploy/secrets/network-config.local (gitignored) and customize.
# sync_to_sd_mac.sh copies the .local file to the SD boot partition.

country: US

network:
  version: 2
  renderer: NetworkManager
  wifis:
    wlan0:
      dhcp4: true
      optional: true
      access-points:
        "YOUR_SSID":
          password: "YOUR_PASSWORD"
