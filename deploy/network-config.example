# Copy to deploy/secrets/network-config.local (gitignored) and customize.
# sync_to_sd_mac.sh copies the .local file to the SD boot partition.
# Do NOT put #cloud-config here — that header is only for user-data (breaks WiFi on Pi).

country: US

network:
  version: 2
  renderer: NetworkManager
  wifis:
    wlan0:
      dhcp4: true
      optional: true
      access-points:
        "YOUR_SSID":
          # Quote passwords that contain spaces or special characters.
          password: "YOUR_PASSWORD"
