# Pi pulls from GitHub automatically when AUTO_PULL=1 (default for appliances).
# Copied to /etc/pi-ambient-synth/deploy.conf on first boot.

DEPLOY_SOURCE=github
AUTO_PULL=1
DEPLOY_SHA=latest
GITHUB_REPO=samjhill/driftline-synth
GITHUB_BRANCH=main
ENABLE_SERVICES=1

# Optional: for private repo, place token in deploy/secrets/github_token (gitignored)
# GITHUB_TOKEN=

# Mac SD sync override: DEPLOY_SOURCE=boot disables GitHub pull
