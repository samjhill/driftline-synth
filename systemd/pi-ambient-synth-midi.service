[Unit]
Description=Pi Ambient Synth MIDI bridge (KeyStep → OSC or direct ALSA)
After=sound.target
Wants=supercollider.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-ambient-synth
Environment=HOME=/home/pi
Environment=PI_MIDI_MAIN_THREAD=1
Environment=PI_DIRECT_ALSA_KEYS=0
Environment=LOG_LEVEL=INFO
# direct_keys drop-in: deploy/systemd/pi-ambient-synth-midi.direct-keys.conf (pi_enable_direct_keys.sh)
ExecStart=/home/pi/pi-ambient-synth/.venv/bin/python /home/pi/pi-ambient-synth/scripts/pi_midi_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
