[Unit]
Description=Pi Ambient Synth e-ink (Waveshare 2.13 V4, ingest-style PNG watch)
After=multi-user.target pi-ambient-synth-midi.service
Wants=pi-ambient-synth-midi.service

[Service]
Type=simple
EnvironmentFile=-/etc/pi-ambient-synth/eink.env
WorkingDirectory=/home/pi/pi-ambient-synth
ExecStart=/usr/bin/python3 /home/pi/pi-ambient-synth/scripts/pi_eink_waveshare213v4.py
Restart=on-failure
RestartSec=5
# Root ensures SPI access (same as ingest ghostroll-eink.service)

[Install]
WantedBy=multi-user.target
