[Unit]
Description=Flues-Synth engine (ALSA headphones)
After=sound.target
Conflicts=supercollider.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-ambient-synth
Environment=HOME=/home/pi
Environment=FLUES_CONTROL_NOTES=0
ExecStartPre=/bin/sh -c 'pkill -x flues-synth jackd scsynth sclang 2>/dev/null || true; sleep 0.5'
ExecStart=/home/pi/pi-ambient-synth/bin/flues-synth plughw:0,0
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
