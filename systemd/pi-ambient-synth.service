[Unit]
Description=Pi Ambient Synth Controller
After=supercollider.service pi-ambient-synth-network-announce.service
Requires=supercollider.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
User=pi
WorkingDirectory=/home/pi/pi-ambient-synth
# E-ink SPI can SIGBUS when the panel busy pin sticks (see eink log); synth/MIDI still work without it.
ExecStart=/home/pi/pi-ambient-synth/.venv/bin/python /home/pi/pi-ambient-synth/src/main.py --no-eink
Environment=PI_NO_MIDI=1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
